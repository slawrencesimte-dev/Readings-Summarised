<!-- ── NOTES PANEL ─────────────────────────────────── -->
<div class="notes-panel" id="notesPanel">
  <div class="notes-panel-header">
    <h3>📝 My Notes</h3>
    <button class="notes-panel-close" onclick="closeNotesPanel()">×</button>
  </div>
  <div class="notes-filter" id="notesFilter">
    <button class="active" data-filter="all" onclick="filterNotes('all',this)">All</button>
    <button data-filter="art1" onclick="filterNotes('art1',this)">Art. 1</button>
    <button data-filter="art2" onclick="filterNotes('art2',this)">Art. 2</button>
    <button data-filter="art3" onclick="filterNotes('art3',this)">Art. 3</button>
    <button data-filter="art4" onclick="filterNotes('art4',this)">Art. 4</button>
    <button data-filter="art5" onclick="filterNotes('art5',this)">Art. 5</button>
    <button data-filter="art6" onclick="filterNotes('art6',this)">Case</button>
  </div>
  <div class="notes-list" id="notesList">
    <p class="notes-empty">No notes yet. Open any article and click "My Notes" to add one.</p>
  </div>
</div>

<button id="back-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Back to top">↑</button>

<script>
  // ── PROGRESS BAR
  window.addEventListener('scroll', () => {
    const el = document.documentElement;
    const prog = (el.scrollTop / (el.scrollHeight - el.clientHeight)) * 100;
    document.getElementById('progress-bar').style.width = prog + '%';
    document.getElementById('back-top').classList.toggle('visible', el.scrollTop > 400);
  });

  // ── TOC COLLAPSE
  function toggleToc() {
    const body = document.getElementById('toc-body');
    const label = document.getElementById('toc-toggle-label');
    const visible = body.style.display !== 'none';
    body.style.display = visible ? 'none' : 'block';
    label.textContent = visible ? '▼ Show' : '▲ Hide';
  }

  // ── ARTICLE COLLAPSE
  function toggleArticle(id) {
    const art = document.getElementById(id);
    art.classList.toggle('collapsed');
  }

  function expandAll() {
    document.querySelectorAll('.article').forEach(a => a.classList.remove('collapsed'));
    document.querySelectorAll('.collapsible-section').forEach(s => s.classList.remove('sec-collapsed'));
  }
  function collapseAll() {
    document.querySelectorAll('.article').forEach(a => a.classList.add('collapsed'));
  }

  // ── SECTION COLLAPSE
  function toggleSection(headerEl) {
    const section = headerEl.closest('.collapsible-section');
    section.classList.toggle('sec-collapsed');
  }

  // ── TOOLBAR + SIDEBAR ACTIVE STATE on scroll
  const articleIds = ['art1','art2','art3','art4','art5','art6'];
  const toolbarLinks = {};
  const sidebarLinks = {};
  articleIds.forEach(id => {
    const tl = document.querySelector(`.toolbar-nav a[href="#${id}"]`);
    if (tl) toolbarLinks[id] = tl;
    const sl = document.querySelector(`.sidebar a[href="#${id}"]`);
    if (sl) sidebarLinks[id] = sl;
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const tl = toolbarLinks[entry.target.id];
      if (tl) tl.classList.toggle('active', entry.isIntersecting);
      const sl = sidebarLinks[entry.target.id];
      if (sl) sl.classList.toggle('active', entry.isIntersecting);
    });
  }, { rootMargin: '-10% 0px -80% 0px' });

  articleIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // ── SMOOTH SCROLL for toolbar/sidebar links (open collapsed articles on click)
  document.querySelectorAll('.toolbar-nav a, .toc-body a, .sidebar a').forEach(link => {
    link.addEventListener('click', e => {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const artMatch = href.match(/^#(art\d+)/);
      const target = document.querySelector(href);
      if (artMatch) {
        const art = document.getElementById(artMatch[1]);
        if (art && art.classList.contains('collapsed')) art.classList.remove('collapsed');
      }
      if (target) {
        // reveal section if inside a collapsed sec
        const sec = target.closest('.collapsible-section');
        if (sec && sec.classList.contains('sec-collapsed')) sec.classList.remove('sec-collapsed');
      }
    });
  });

  // ── SIDEBAR TOGGLE
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('visible');
  }
  function closeSidebar() {
    if (window.innerWidth <= 900) {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarOverlay').classList.remove('visible');
    }
  }

  // ── NOTES PANEL
  function openNotesPanel() {
    document.getElementById('notesPanel').classList.add('open');
    renderNotesPanel();
  }
  function closeNotesPanel() {
    document.getElementById('notesPanel').classList.remove('open');
  }

  // ── NOTES SYSTEM
  const NOTES_KEY = 'cb_notes_v1';
  const ART_NAMES = {
    art1: 'Art.1 · CRM & Prediction',
    art2: 'Art.2 · Marketing Myopia',
    art3: 'Art.3 · Elements of Value',
    art4: 'Art.4 · Science of Sensory',
    art5: 'Art.5 · Sensory Backfires',
    art6: 'Case · Oreo India',
  };
  const ART_TYPE = { art1:'crm', art2:'crm', art3:'crm', art4:'sens', art5:'sens', art6:'case' };

  function getNotes() {
    try { return JSON.parse(localStorage.getItem(NOTES_KEY)) || []; }
    catch(e) { return []; }
  }
  function persistNotes(arr) { localStorage.setItem(NOTES_KEY, JSON.stringify(arr)); }

  function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/\n/g,'<br>');
  }

  function saveNote(artId) {
    const ta = document.getElementById('nta-' + artId);
    const text = ta.value.trim();
    if (!text) return;
    const notes = getNotes();
    notes.push({ id: Date.now(), artId, text, ts: new Date().toLocaleString() });
    persistNotes(notes);
    ta.value = '';
    renderArticleNotes(artId);
    renderNotesPanel();
    updateNotesCount();
    const btn = ta.closest('.notes-input-wrap').querySelector('.btn-save-note');
    const orig = btn.textContent;
    btn.textContent = '✓ Saved!';
    setTimeout(() => { btn.textContent = orig; }, 1600);
  }

  function deleteNote(noteId) {
    persistNotes(getNotes().filter(n => n.id !== noteId));
    Object.keys(ART_NAMES).forEach(id => renderArticleNotes(id));
    renderNotesPanel();
    updateNotesCount();
  }

  function renderArticleNotes(artId) {
    const cont = document.getElementById('existing-' + artId);
    if (!cont) return;
    const notes = getNotes().filter(n => n.artId === artId);
    cont.innerHTML = notes.map(n => `
      <div class="existing-note">
        <span class="note-text">${escHtml(n.text)}</span>
        <button class="note-del" onclick="deleteNote(${n.id})" title="Delete">×</button>
      </div>`).join('');
  }

  let _activeFilter = 'all';
  function filterNotes(filter, btn) {
    _activeFilter = filter;
    document.querySelectorAll('.notes-filter button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderNotesPanel(filter);
  }

  function renderNotesPanel(filter) {
    filter = filter || _activeFilter;
    const list = document.getElementById('notesList');
    let notes = getNotes();
    if (filter !== 'all') notes = notes.filter(n => n.artId === filter);
    if (!notes.length) {
      list.innerHTML = '<p class="notes-empty">No notes yet. Open any article and click "My Notes" to add one.</p>';
      return;
    }
    list.innerHTML = notes.slice().reverse().map(n => `
      <div class="note-item">
        <div class="note-item-source">
          <span class="note-source-badge badge-${ART_TYPE[n.artId]}">${n.artId.replace('art','Art.')}</span>
          <span class="note-source-label">${ART_NAMES[n.artId]}</span>
        </div>
        <div class="note-timestamp">${n.ts}</div>
        <p>${escHtml(n.text)}</p>
        <div class="note-item-actions">
          <button class="btn-note-goto" onclick="gotoArt('${n.artId}')">Go to article</button>
          <button class="btn-note-del" onclick="deleteNote(${n.id})">Delete</button>
        </div>
      </div>`).join('');
  }

  function gotoArt(artId) {
    closeNotesPanel();
    const el = document.getElementById(artId);
    if (el) {
      if (el.classList.contains('collapsed')) el.classList.remove('collapsed');
      setTimeout(() => el.scrollIntoView({ behavior:'smooth', block:'start' }), 120);
    }
  }

  function updateNotesCount() {
    const count = getNotes().length;
    const sb = document.getElementById('sidebarNotesBtn');
    if (sb) sb.textContent = `📝 ${count} note${count !== 1 ? 's' : ''} — View all`;
    const tb = document.getElementById('notesToolbarBtn');
    if (tb) {
      tb.textContent = count > 0 ? `Notes (${count})` : 'Notes';
      tb.classList.toggle('has-notes', count > 0);
    }
  }

  function toggleNotesInput(artId) {
    const wrap = document.getElementById('niwrap-' + artId);
    const btn  = document.getElementById('ntbtn-' + artId);
    const arrow = btn && btn.querySelector('.n-arrow');
    const isOpen = wrap.classList.toggle('open');
    if (btn) btn.classList.toggle('open', isOpen);
    if (arrow) arrow.textContent = isOpen ? '▾' : '▸';
    if (isOpen) renderArticleNotes(artId);
  }

  // ── INIT
  (function init() {
    Object.keys(ART_NAMES).forEach(id => renderArticleNotes(id));
    updateNotesCount();
  })();
</script>
</body>
</html>
