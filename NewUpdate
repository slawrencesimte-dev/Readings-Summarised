<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Consumer Behavior – Article Summaries | IIMU MBA Term IV</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --red:      #8b1a1a;
      --red-light:#f8f0f0;
      --red-mid:  #e0c4c4;
      --teal:     #0d6e6e;
      --teal-light:#edf6f6;
      --teal-mid: #b3d9d9;
      --navy:     #1a2a5e;
      --oreo:     #0057a8;
      --oreo-light:#edf3fb;
      --oreo-mid: #b3cfe8;
      --gold:     #c0830a;
      --bg:       #f4f1ec;
      --text:     #1a1a1a;
      --muted:    #555;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Georgia', serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.75;
      padding: 0;
    }

    /* ── PROGRESS BAR ─────────────────────────────── */
    #progress-bar {
      position: fixed; top: 0; left: 0; height: 3px;
      background: linear-gradient(90deg, var(--red), var(--gold));
      width: 0%; z-index: 1000;
      transition: width 0.1s linear;
    }

    /* ── TOP TOOLBAR ──────────────────────────────── */
    .toolbar {
      position: sticky; top: 0; z-index: 900;
      background: #fff;
      border-bottom: 2px solid var(--red);
      padding: 0.55rem 1.5rem;
      display: flex; align-items: center; gap: 1rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .toolbar-title {
      font-size: 0.85rem; font-weight: 700;
      color: var(--red); letter-spacing: 0.05em;
      text-transform: uppercase; white-space: nowrap;
      flex-shrink: 0;
    }
    .toolbar-nav {
      display: flex; gap: 0.35rem; flex-wrap: wrap; flex: 1;
    }
    .toolbar-nav a {
      font-size: 0.72rem; color: #444; text-decoration: none;
      padding: 0.2rem 0.55rem; border-radius: 20px;
      border: 1px solid #ddd;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .toolbar-nav a:hover, .toolbar-nav a.active {
      background: var(--red); color: #fff; border-color: var(--red);
    }
    .toolbar-nav a.type-sensory { border-color: var(--teal-mid); color: var(--teal); }
    .toolbar-nav a.type-sensory:hover, .toolbar-nav a.type-sensory.active {
      background: var(--teal); color: #fff; border-color: var(--teal);
    }
    .toolbar-nav a.type-case { border-color: var(--oreo-mid); color: var(--oreo); }
    .toolbar-nav a.type-case:hover, .toolbar-nav a.type-case.active {
      background: var(--oreo); color: #fff; border-color: var(--oreo);
    }
    .toolbar-actions {
      display: flex; gap: 0.5rem; flex-shrink: 0;
    }
    .btn-small {
      font-size: 0.72rem; padding: 0.2rem 0.7rem;
      border-radius: 4px; border: 1px solid #ccc;
      background: #fafafa; cursor: pointer; color: #444;
      font-family: inherit;
      transition: all 0.2s;
    }
    .btn-small:hover { background: var(--red); color: #fff; border-color: var(--red); }

    /* ── LAYOUT ───────────────────────────────────── */
    .page-wrap {
      max-width: 980px; margin: 0 auto; padding: 2rem 1rem 4rem;
    }

    /* ── HEADER ───────────────────────────────────── */
    header {
      text-align: center;
      border-bottom: 3px solid var(--red);
      padding-bottom: 1.5rem;
      margin-bottom: 2.5rem;
    }
    header h1 { font-size: 2rem; color: var(--red); letter-spacing: 0.04em; margin-bottom: 0.4rem; }
    header p { font-size: 0.95rem; color: var(--muted); font-style: italic; }

    /* ── TOC ──────────────────────────────────────── */
    .toc {
      background: #fff;
      border-left: 5px solid var(--red);
      padding: 1.2rem 1.8rem;
      border-radius: 4px;
      margin-bottom: 3rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .toc-header {
      display: flex; align-items: center; justify-content: space-between;
      cursor: pointer; user-select: none;
    }
    .toc h2 { font-size: 1rem; color: var(--red); text-transform: uppercase; letter-spacing: 0.08em; }
    .toc-toggle { font-size: 0.8rem; color: var(--muted); }
    .toc-body { margin-top: 0.8rem; }
    .toc-body ol { margin-left: 1.2rem; }
    .toc-body li { margin-bottom: 0.35rem; }
    .toc-body a { color: #333; text-decoration: none; font-size: 0.95rem; }
    .toc-body a:hover { color: var(--red); text-decoration: underline; }
    .toc-body .toc-tag {
      display: inline-block; font-size: 0.68rem; padding: 0.1rem 0.4rem;
      border-radius: 10px; margin-left: 0.4rem; vertical-align: middle;
    }
    .tag-crm   { background:#f8e8e8; color:var(--red); border:1px solid var(--red-mid); }
    .tag-sens  { background:var(--teal-light); color:var(--teal); border:1px solid var(--teal-mid); }
    .tag-case  { background:var(--oreo-light); color:var(--oreo); border:1px solid var(--oreo-mid); }
    .toc-section-label {
      font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
      color: #999; margin-top: 0.8rem; margin-bottom: 0.3rem;
      padding-bottom: 0.2rem; border-bottom: 1px solid #eee;
    }

    /* ── ARTICLE CARD ─────────────────────────────── */
    .article {
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 14px rgba(0,0,0,0.07);
      margin-bottom: 2.5rem;
      transition: box-shadow 0.2s;
    }
    .article:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.11); }

    /* colour themes */
    .theme-crm   .article-header { background: var(--red); }
    .theme-sens  .article-header { background: var(--teal); }
    .theme-case  .article-header { background: var(--oreo); }

    .article-header {
      color: #fff;
      padding: 1.4rem 2rem;
      cursor: pointer;
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 1rem;
      user-select: none;
    }
    .article-header-content { flex: 1; }
    .article-num {
      font-size: 0.75rem; text-transform: uppercase;
      letter-spacing: 0.12em; opacity: 0.75; margin-bottom: 0.4rem;
    }
    .article-header h2 {
      font-size: 1.45rem; margin-bottom: 0.45rem; line-height: 1.3;
    }
    .article-header .meta { font-size: 0.88rem; opacity: 0.85; font-style: italic; }
    .article-chevron {
      font-size: 1.3rem; opacity: 0.7; transition: transform 0.3s ease;
      align-self: center; flex-shrink: 0;
    }
    .article.collapsed .article-chevron { transform: rotate(-90deg); }

    /* article body collapse */
    .article-body-wrap {
      overflow: hidden;
      transition: max-height 0.45s ease, opacity 0.35s ease;
      max-height: 9999px; opacity: 1;
    }
    .article.collapsed .article-body-wrap {
      max-height: 0; opacity: 0;
    }
    .article-body { padding: 2rem 2.2rem; }

    /* ── QUICK FACTS ──────────────────────────────── */
    .quick-facts { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.8rem; }
    .quick-facts span {
      border-radius: 20px; padding: 0.25rem 0.85rem;
      font-size: 0.8rem; font-weight: 700;
    }
    .theme-crm  .quick-facts span { background:var(--red-light); border:1px solid var(--red-mid); color:#7a1515; }
    .theme-sens .quick-facts span { background:var(--teal-light); border:1px solid var(--teal-mid); color:var(--teal); }
    .theme-case .quick-facts span { background:var(--oreo-light); border:1px solid var(--oreo-mid); color:var(--oreo); }

    /* ── SECTION HEADINGS ─────────────────────────── */
    .collapsible-section { margin-top: 1.8rem; }
    .section-toggle {
      display: flex; align-items: center; justify-content: space-between;
      cursor: pointer; user-select: none;
      font-size: 1.1rem; font-weight: 700;
      padding-bottom: 0.3rem;
      border-bottom: 1px solid #e8d8d8;
      margin-bottom: 0.6rem;
    }
    .theme-sens .section-toggle { border-bottom-color: var(--teal-mid); }
    .theme-case .section-toggle { border-bottom-color: var(--oreo-mid); }
    .theme-crm  .section-toggle { color: var(--red); }
    .theme-sens .section-toggle { color: var(--teal); }
    .theme-case .section-toggle { color: var(--oreo); }
    .section-chevron { font-size: 0.85rem; opacity: 0.6; transition: transform 0.25s; }
    .collapsible-section.sec-collapsed .section-chevron { transform: rotate(-90deg); }
    .section-body {
      overflow: hidden;
      transition: max-height 0.35s ease, opacity 0.25s ease;
      max-height: 9999px; opacity: 1;
    }
    .collapsible-section.sec-collapsed .section-body { max-height: 0; opacity: 0; }

    .article-body h3 { /* legacy non-collapsible */
      font-size: 1.1rem; margin-top: 1.8rem; margin-bottom: 0.6rem;
      padding-bottom: 0.3rem; border-bottom: 1px solid #e8d8d8;
    }
    .theme-crm  .article-body h3 { color: var(--red); }
    .theme-sens .article-body h3 { color: var(--teal); }
    .theme-case .article-body h3 { color: var(--oreo); }
    .article-body h4 { font-size: 1rem; color: #333; margin-top: 1.2rem; margin-bottom: 0.4rem; font-style: italic; }
    .article-body p { margin-bottom: 0.9rem; font-size: 0.97rem; }
    .article-body ul, .article-body ol { margin-left: 1.4rem; margin-bottom: 0.9rem; }
    .article-body li { margin-bottom: 0.45rem; font-size: 0.97rem; }

    /* ── CALLOUT ──────────────────────────────────── */
    .callout {
      border-left: 4px solid var(--gold);
      background: #fff9f0;
      padding: 0.9rem 1.2rem;
      margin: 1.2rem 0;
      font-style: italic;
      color: #5a3a00;
      font-size: 0.97rem;
      border-radius: 0 4px 4px 0;
    }
    .callout.teal-callout {
      border-left-color: var(--teal); background: var(--teal-light); color: #0a3a3a;
    }
    .callout.blue-callout {
      border-left-color: var(--oreo); background: var(--oreo-light); color: #002d5a;
    }

    /* ── CONCEPT GRID ─────────────────────────────── */
    .concept-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.8rem; margin: 1rem 0 1.5rem;
    }
    .concept-box { border-radius: 5px; padding: 0.7rem 1rem; }
    .theme-crm  .concept-box { background:var(--red-light); border:1px solid var(--red-mid); }
    .theme-crm  .concept-box strong { color: var(--red); }
    .theme-sens .concept-box { background:var(--teal-light); border:1px solid var(--teal-mid); }
    .theme-sens .concept-box strong { color: var(--teal); }
    .theme-case .concept-box { background:var(--oreo-light); border:1px solid var(--oreo-mid); }
    .theme-case .concept-box strong { color: var(--oreo); }
    .concept-box strong { display: block; font-size: 0.88rem; margin-bottom: 0.25rem; }
    .concept-box p { font-size: 0.84rem; color: #444; margin: 0; }

    /* ── FRAMEWORK BOX ────────────────────────────── */
    .framework-box {
      background: #f0f4ff; border: 1px solid #c0ccee;
      border-radius: 5px; padding: 1rem 1.3rem; margin: 1.2rem 0;
    }
    .framework-box strong {
      display: block; color: var(--navy);
      font-size: 0.9rem; margin-bottom: 0.4rem;
      text-transform: uppercase; letter-spacing: 0.06em;
    }
    .framework-box p { font-size: 0.9rem; color: #2a2a4a; margin: 0; }

    /* ── CHARACTER CARD ───────────────────────────── */
    .character-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem; margin: 1rem 0 1.5rem;
    }
    .character-card {
      background: var(--oreo-light); border: 1px solid var(--oreo-mid);
      border-radius: 8px; padding: 1rem 1.2rem;
    }
    .character-card .char-name {
      font-weight: 700; font-size: 0.95rem; color: var(--oreo);
      margin-bottom: 0.15rem;
    }
    .character-card .char-role {
      font-size: 0.78rem; color: #555; font-style: italic; margin-bottom: 0.55rem;
    }
    .character-card p { font-size: 0.85rem; color: #333; margin: 0; }

    /* ── CB MOMENT ────────────────────────────────── */
    .cb-moment {
      border-left: 4px solid var(--oreo);
      background: #f5faff;
      border-radius: 0 6px 6px 0;
      padding: 0.9rem 1.2rem;
      margin: 1rem 0;
    }
    .cb-moment .moment-label {
      font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--oreo); font-weight: 700; margin-bottom: 0.35rem;
    }
    .cb-moment p { font-size: 0.92rem; color: #1a2a3a; margin: 0; }

    /* ── BRAND COMPARE ────────────────────────────── */
    .brand-compare {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0.8rem; margin: 1rem 0 1.5rem;
    }
    .brand-card {
      border-radius: 7px; padding: 1rem; text-align: center;
    }
    .brand-card.oreo   { background:#edf3fb; border:2px solid var(--oreo); }
    .brand-card.dark   { background:#1a1a1a; border:2px solid #555; }
    .brand-card.magic  { background:#fff5f0; border:2px solid #c0500a; }
    .brand-card .b-name { font-weight: 700; font-size: 0.92rem; margin-bottom: 0.4rem; }
    .brand-card.oreo  .b-name { color: var(--oreo); }
    .brand-card.dark  .b-name { color: #e8c840; }
    .brand-card.magic .b-name { color: #c0500a; }
    .brand-card p { font-size: 0.8rem; line-height: 1.5; }
    .brand-card.dark p { color: #ccc; }

    /* ── SCORE TABLE ──────────────────────────────── */
    .score-highlight { font-weight: 700; color: var(--oreo); }
    .score-high { background: #dff0d8 !important; }
    .score-mid  { background: #fff5cc !important; }

    /* ── TABLE ────────────────────────────────────── */
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin: 1rem 0 1.5rem; }
    th { color: #fff; padding: 0.55rem 0.9rem; text-align: left; }
    .theme-crm  th { background: var(--red); }
    .theme-sens th { background: var(--teal); }
    .theme-case th { background: var(--oreo); }
    td { padding: 0.5rem 0.9rem; border-bottom: 1px solid #ececec; }
    tr:nth-child(even) td { background: #fafafa; }

    /* ── PYRAMID ──────────────────────────────────── */
    .pyramid { text-align: center; margin: 1.2rem 0; }
    .pyramid-level {
      display: block; margin: 0 auto 4px; padding: 0.45rem 1rem;
      border-radius: 3px; font-size: 0.88rem; font-weight: 700;
      color: #fff; letter-spacing: 0.03em;
    }
    .p1 { background: #2c3e6e; width: 22%; }
    .p2 { background: #3a5498; width: 44%; }
    .p3 { background: #5577bb; width: 66%; }
    .p4 { background: #7799cc; width: 88%; }
    .pyramid-caption { font-size: 0.8rem; color: #666; margin-top: 0.4rem; }

    /* ── SINCERE / EXCITING SPLIT ─────────────────── */
    .brand-personality-split {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0 1.5rem;
    }
    .bp-box { border-radius: 7px; padding: 1rem 1.2rem; }
    .bp-sincere { background: #f0f8f0; border: 1px solid #a3c9a3; }
    .bp-exciting { background: #fff0f5; border: 1px solid #f0a0b0; }
    .bp-box h4 { font-size: 0.9rem; margin-bottom: 0.4rem; font-style: normal; }
    .bp-sincere h4 { color: #2a6a2a; }
    .bp-exciting h4 { color: #a02040; }
    .bp-box p { font-size: 0.85rem; margin: 0; color: #333; }

    /* ── BACK TO TOP ──────────────────────────────── */
    #back-top {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      background: var(--red); color: #fff; border: none;
      border-radius: 50%; width: 42px; height: 42px;
      font-size: 1.2rem; cursor: pointer;
      box-shadow: 0 3px 10px rgba(0,0,0,0.25);
      opacity: 0; pointer-events: none;
      transition: opacity 0.3s;
      z-index: 800;
    }
    #back-top.visible { opacity: 1; pointer-events: all; }

    /* ── FOOTER ───────────────────────────────────── */
    footer {
      max-width: 980px; margin: 2rem auto 0;
      text-align: center; font-size: 0.82rem; color: #888;
      border-top: 1px solid #ddd; padding-top: 1rem;
    }

    /* ── RESPONSIVE ───────────────────────────────── */
    @media (max-width: 700px) {
      .article-header h2 { font-size: 1.2rem; }
      .article-body { padding: 1.2rem 1rem; }
      .brand-compare { grid-template-columns: 1fr; }
      .brand-personality-split { grid-template-columns: 1fr; }
      .toolbar-nav { display: none; }
      .p1{width:45%} .p2{width:62%} .p3{width:80%} .p4{width:100%}
    }

    /* ── LAYOUT OUTER (sidebar + main) ───────────── */
    .layout-outer {
      display: flex;
      align-items: flex-start;
    }
    .content-main { flex: 1; min-width: 0; }

    /* ── SIDEBAR ──────────────────────────────────── */
    .sidebar {
      width: 222px;
      flex-shrink: 0;
      position: sticky;
      top: 50px;
      max-height: calc(100vh - 50px);
      overflow-y: auto;
      background: #fff;
      border-right: 2px solid var(--red-mid);
      padding: 0.8rem 0 2rem;
      font-family: 'Georgia', serif;
      transition: transform 0.3s ease;
      z-index: 100;
    }
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: #ddd; border-radius: 2px; }
    .sidebar-section-label {
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      color: #aaa;
      padding: 0.65rem 1rem 0.2rem;
      border-bottom: 1px solid #f0e8e8;
      margin-bottom: 0.15rem;
    }
    .sidebar-section-label + .sidebar-section-label,
    .sidebar-section-label:not(:first-child) { margin-top: 0.7rem; }
    .sidebar a {
      display: block;
      font-size: 0.78rem;
      color: #444;
      text-decoration: none;
      padding: 0.28rem 0.9rem 0.28rem 1rem;
      border-left: 3px solid transparent;
      transition: all 0.15s;
      line-height: 1.4;
    }
    .sidebar a:hover { color: var(--red); background: var(--red-light); border-left-color: var(--red); }
    .sidebar a.active { color: var(--red); background: var(--red-light); border-left-color: var(--red); font-weight: 700; }
    .sidebar a.s-sens:hover, .sidebar a.s-sens.active { color: var(--teal); background: var(--teal-light); border-left-color: var(--teal); }
    .sidebar a.s-case:hover, .sidebar a.s-case.active { color: var(--oreo); background: var(--oreo-light); border-left-color: var(--oreo); }
    .sidebar a.sub-link {
      padding-left: 1.8rem;
      font-size: 0.73rem;
      color: #666;
    }
    .sidebar a.sub-link:hover, .sidebar a.sub-link.active {
      color: var(--oreo); background: var(--oreo-light); border-left-color: var(--oreo);
    }
    .sidebar-notes-btn {
      display: block;
      margin: 0.9rem 0.8rem 0;
      font-size: 0.72rem;
      padding: 0.4rem 0.6rem;
      background: #fdf9f4;
      border: 1px solid #e8dcc8;
      border-radius: 5px;
      cursor: pointer;
      text-align: center;
      color: #888;
      font-family: inherit;
      transition: all 0.2s;
      width: calc(100% - 1.6rem);
    }
    .sidebar-notes-btn:hover { background: var(--red-light); border-color: var(--red-mid); color: var(--red); }

    /* ── SIDEBAR TOGGLE (mobile) ──────────────────── */
    .btn-sidebar-toggle {
      display: none;
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: var(--red);
      padding: 0.1rem 0.3rem;
      flex-shrink: 0;
    }
    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.35);
      z-index: 88;
    }
    .sidebar-overlay.visible { display: block; }

    /* ── NOTES BUTTON IN TOOLBAR ──────────────────── */
    .btn-notes {
      font-size: 0.72rem; padding: 0.2rem 0.7rem;
      border-radius: 4px; border: 1px solid var(--gold);
      background: #fff9f0; cursor: pointer;
      color: #a06808; font-family: inherit;
      transition: all 0.2s; font-weight: 700;
    }
    .btn-notes:hover, .btn-notes.has-notes {
      background: var(--gold); color: #fff; border-color: var(--gold);
    }

    /* ── NOTES PANEL (slide-in from right) ────────── */
    .notes-panel {
      position: fixed;
      right: -420px; top: 0;
      width: 390px; height: 100vh;
      background: #fffdf9;
      border-left: 2px solid var(--gold);
      box-shadow: -4px 0 24px rgba(0,0,0,0.13);
      z-index: 980;
      transition: right 0.3s ease;
      display: flex; flex-direction: column;
      font-family: 'Georgia', serif;
    }
    .notes-panel.open { right: 0; }
    .notes-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.2rem;
      border-bottom: 1px solid #e8dcc8;
      background: #fff; flex-shrink: 0;
    }
    .notes-panel-header h3 { font-size: 0.98rem; color: var(--navy); text-transform: uppercase; letter-spacing: 0.06em; }
    .notes-panel-close {
      background: none; border: none; font-size: 1.5rem; cursor: pointer;
      color: #aaa; line-height: 1; padding: 0 0.2rem;
    }
    .notes-panel-close:hover { color: var(--red); }
    .notes-filter {
      display: flex; gap: 0.3rem; flex-wrap: wrap;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid #ede5d8;
